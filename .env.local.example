# Wedding Gift Registry — set a secret in production
REGISTRY_SECRET=change-this-to-a-random-string

# Production (Vercel): connect a Blob store under Project → Storage.
# Vercel sets BLOB_STORE_ID (OIDC auth). BLOB_READ_WRITE_TOKEN is optional/legacy.
# Optional fallback: Vercel KV sets KV_REST_API_URL and KV_REST_API_TOKEN.
